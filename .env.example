# Claudeploy - copie para .env e ajuste.

# Venue: pons (Robinhood Chain, padrao) ou argus (Arc, chain da Circle).
# Cada deploy serve UM venue; use DATA_DIR separados.
VENUE=pons

# Porta local e URL publica (a URL publica entra nos links de assinatura e no
# endereco do conector; no Railway use o dominio do servico, sem barra no fim).
PORT=8436
PUBLIC_URL=http://localhost:8436

# Onde ficam os lancamentos (JSON). No Railway aponte para o volume.
DATA_DIR=data

# RPC (padrao = a publica de cada chain)
# RPC_URL=https://rpc.mainnet.chain.robinhood.com
# RPC_URL=https://rpc.mainnet.arc.io

# Contratos da pons v2 (padrao = mainnet, docs.ponsfamily.com/docs/v2)
# PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_LAUNCH_AND_BUY=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948
# PONS_LAUNCH_CONFIG_ID=0
# PONS_TOKEN_URL=https://www.ponsfamily.com/launchpad/{token}

# Contratos da Argus (padrao = mainnet da Arc, lidos da chain em 16/09/2026)
# ARGUS_PORTAL=0xB021Be536808f551b31789422Fd28a6c9c6e97Da
# ARGUS_TOKEN_URL=https://argus.world/token/{token}

# Regras do produto
MAX_DEV_BUY_BPS=500
# DEFAULT_CREATOR_TAX_BPS=0        # pons: 0; argus: 300 (3% compra e 3% venda)
LAUNCH_TTL_HOURS=24

# Dominio principal (sem https). Outros hosts redirecionam as paginas para ele.
# CANONICAL_HOST=claudeploy.fun
# O outro deploy (o site aponta para ele no rodape)
# OTHER_VENUE_URL=https://arc.claudeploy.fun

# ---- Agentes (opcional). Sem AGENT_SECRET o modulo fica desligado. ----
# Segredo que cifra as chaves das carteiras dos agentes e as credenciais do X.
# Gere um valor aleatorio longo e NUNCA troque depois de ter agentes ativos.
# AGENT_SECRET=
# Carteira sua que recebe o aluguel do cerebro (fracao das taxas coletadas).
# TREASURY_ADDRESS=0x...
# AGENT_RENT_BPS=1000        # 10% das taxas -> TREASURY_ADDRESS
# AGENT_INTERVAL_MIN=5       # ciclo
# Valores em moeda do venue (ETH na pons, USDC na Argus). Padroes: pons 0.001/0.002/0.0005/0.002; argus 1/2/0.3/3
# AGENT_RESERVE=             # nunca gasta abaixo disto
# AGENT_MIN_ACTION=          # abaixo disto o agente dorme
# AGENT_MIN_GAS=             # abaixo disto o agente so avisa que precisa de gas
# AGENT_KICKSTART=           # gas inicial sugerido (argus: tambem entra na conta do lancamento pelo agente)
# Voz do agente (posts). Sem chave, usa frases prontas.
# ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5

# Token oficial da casa (lancado fora do fluxo): aparece no topo do site
# OFFICIAL_TOKEN=0x...
# OFFICIAL_SYMBOL=CLAUDEPLOY
